{
  "name": "hydrareel",
  "version": "0.1.0",
  "private": true,
  "description": "HydraReel MVP-001: long video to vertical AI-selected clips.",
  "license": "UNLICENSED",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
